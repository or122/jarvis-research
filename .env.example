# Jarvis — the petrol engine's key.
#
# Copy this file to ".env" in the same folder and put your real key in it:
#
#     cp .env.example .env
#     open -e .env          # paste the key, save, close
#
# .env is in .gitignore, so your key can never be committed or pushed.
# NEVER put a real key in THIS file — .env.example IS committed.
#
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-put-your-real-key-here

# Optional. Which model the petrol engine runs. The default is Claude Opus 5
# at $5/$25 per million tokens. Others:
#   claude-fable-5-1  $10/$50   most capable, twice the price
#   claude-sonnet-5   $2/$10    cheaper, still strong
#   claude-haiku-4-5  $1/$5     cheapest, noticeably weaker
# JARVIS_PETROL=claude-opus-5

# Optional. A hard ceiling on how long one paid answer can be.
# JARVIS_MAX_TOKENS=4096
